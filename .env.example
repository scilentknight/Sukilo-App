# Copy to .env.local and adjust for your environment.
# Both values are public (bundled into the browser); never put secrets in NEXT_PUBLIC_*.

# Base URL of Sukilo-Api, without a trailing slash or /api/v1.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public URL of this storefront (canonical links, sitemap, QR Digital Links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Consent policy version the API currently accepts (the development API uses "dev-1").
NEXT_PUBLIC_CONSENT_POLICY_VERSION=dev-1
